{
  "name": "agregator-stiri",
  "version": "2.6.0",
  "private": true,
  "description": "Personalized news aggregator built with Next.js and Supabase.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/parse-feed.test.ts tests/normalize.test.ts tests/text-and-format.test.ts tests/images.test.ts tests/security.test.ts tests/auth.test.ts tests/reader-prefs.test.ts tests/i18n.test.ts tests/guest-clippings.test.ts tests/retention.test.ts tests/last-visit.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:db": "tsx --test tests/db/feed.db.test.ts tests/db/security.db.test.ts",
    "ingest": "tsx scripts/ingest.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "db:push:dev": "supabase db push --remote=sppfigcxpmhrcybhvbhp",
    "db:push:prod": "supabase db push --remote",
    "db:types": "supabase gen types typescript --remote=sppfigcxpmhrcybhvbhp --schema public > lib/database.types.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
