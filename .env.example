# Copy this file to .env.local and fill in the values.
#   Local Supabase (npm run db:start): copy the values printed by the command.
#   Hosted Supabase: Project Settings > API (or > API Keys on new projects).

# Project URL, e.g. http://127.0.0.1:58321 locally or https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key: the "anon" key, or the newer "publishable" key (sb_publishable_...).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alternative name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key: "service_role", or the newer "secret" key (sb_secret_...).
# Needed to fetch news (npm run ingest, the admin "Fetch news now" button,
# the cron endpoint and the automatic hourly refresh) and to delete accounts
# (after the password check). Never expose it to the browser.
# SUPABASE_SECRET_KEY is accepted as an alternative name.
SUPABASE_SERVICE_ROLE_KEY=

# Protects GET/POST /api/cron/ingest ("Authorization: Bearer <CRON_SECRET>").
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Optional: minutes between automatic refreshes triggered by feed visits (default 60, 0 = off).
INGESTION_INTERVAL_MINUTES=60

# Optional: days an unsaved article is kept (default 30).
ARTICLE_RETENTION_DAYS=30
